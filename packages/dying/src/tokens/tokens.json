{
  "$schema": "https://design-tokens.github.io/community-group/format/draft-spec.json",
  "name": "dying",
  "version": "1.0.0",
  "description": "Dying Design System — OLED Dark Luxury Tokens for Music Streaming",
  "primitive": {
    "color": {
      "black": { "$value": "#000000", "$type": "color" },
      "white": { "$value": "#ffffff", "$type": "color" },
      "zinc-950": { "$value": "#09090b", "$type": "color" },
      "zinc-900": { "$value": "#18181b", "$type": "color" },
      "zinc-800": { "$value": "#27272a", "$type": "color" },
      "emerald-500": { "$value": "#10b981", "$type": "color" },
      "rose-500": { "$value": "#f43f5e", "$type": "color" }
    },
    "opacity": {
      "glass-bg": { "$value": 0.03, "$type": "number" },
      "glass-hover": { "$value": 0.06, "$type": "number" },
      "glass-border": { "$value": 0.08, "$type": "number" },
      "text-primary": { "$value": 1.0, "$type": "number" },
      "text-secondary": { "$value": 0.72, "$type": "number" },
      "text-muted": { "$value": 0.50, "$type": "number" },
      "text-dim": { "$value": 0.35, "$type": "number" }
    },
    "blur": {
      "panel": { "$value": "24px", "$type": "dimension" },
      "card": { "$value": "16px", "$type": "dimension" },
      "aura": { "$value": "120px", "$type": "dimension" }
    },
    "duration": {
      "instant": { "$value": "150ms", "$type": "duration" },
      "smooth": { "$value": "300ms", "$type": "duration" },
      "spring": { "$value": "500ms", "$type": "duration" }
    }
  },
  "semantic": {
    "surface": {
      "canvas": { "$value": "{primitive.color.black}", "$type": "color", "description": "Base OLED pitch black" },
      "glass": { "$value": "rgba(255, 255, 255, {primitive.opacity.glass-bg})", "$type": "color" },
      "glass-hover": { "$value": "rgba(255, 255, 255, {primitive.opacity.glass-hover})", "$type": "color" },
      "glass-border": { "$value": "rgba(255, 255, 255, {primitive.opacity.glass-border})", "$type": "color" }
    },
    "text": {
      "primary": { "$value": "{primitive.color.white}", "$type": "color", "contrastRatio": "21:1" },
      "secondary": { "$value": "rgba(255, 255, 255, {primitive.opacity.text-secondary})", "$type": "color", "contrastRatio": "9.8:1" },
      "muted": { "$value": "rgba(255, 255, 255, {primitive.opacity.text-muted})", "$type": "color", "contrastRatio": "4.6:1" },
      "accent": { "$value": "{primitive.color.emerald-500}", "$type": "color" }
    },
    "feedback": {
      "playing": { "$value": "{primitive.color.emerald-500}", "$type": "color" },
      "error": { "$value": "{primitive.color.rose-500}", "$type": "color" }
    }
  },
  "component": {
    "playerbar": {
      "height": { "$value": "88px", "$type": "dimension" },
      "background": { "$value": "rgba(0, 0, 0, 0.75)", "$type": "color" },
      "blur": { "$value": "32px", "$type": "dimension" }
    },
    "scrubber": {
      "trackHeight": { "$value": "4px", "$type": "dimension" },
      "thumbSize": { "$value": "12px", "$type": "dimension" },
      "hoverTrackHeight": { "$value": "6px", "$type": "dimension" }
    },
    "lyrics": {
      "activeScale": { "$value": 1.05, "$type": "number" },
      "activeGlow": { "$value": "0 0 30px rgba(255, 255, 255, 0.4)", "$type": "shadow" },
      "inactiveOpacity": { "$value": "{primitive.opacity.text-dim}", "$type": "number" }
    }
  }
}
