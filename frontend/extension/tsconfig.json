{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["wxt/browser"]
  },
  "include": [".wxt/types/**/*", "src/**/*"],
  "exclude": ["node_modules", ".output"]
}
