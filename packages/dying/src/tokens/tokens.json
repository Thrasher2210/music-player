{
  "$schema": "https://design-tokens.github.io/community-group/format/draft-spec.json",
  "name": "dying",
  "version": "1.0.0",
  "description": "Dying Design System — Monochrome Graphite Tokens for Music Streaming",
  "primitive": {
    "color": {
      "canvas": { "$value": "#141416", "$type": "color" },
      "sidebar": { "$value": "#121214", "$type": "color" },
      "surface": { "$value": "#1e1e22", "$type": "color" },
      "surface-hover": { "$value": "#28282c", "$type": "color" },
      "surface-active": { "$value": "#2c2c2e", "$type": "color" },
      "border": { "$value": "rgba(255, 255, 255, 0.08)", "$type": "color" },
      "white": { "$value": "#ffffff", "$type": "color" },
      "text-secondary": { "$value": "#98989d", "$type": "color" },
      "text-tertiary": { "$value": "#86868b", "$type": "color" },
      "glass-frosted": { "$value": "rgba(30, 30, 34, 0.85)", "$type": "color" }
    },
    "opacity": {
      "glass-bg": { "$value": 0.85, "$type": "number" },
      "glass-border": { "$value": 0.08, "$type": "number" },
      "text-primary": { "$value": 1.0, "$type": "number" },
      "text-secondary": { "$value": 0.72, "$type": "number" },
      "text-muted": { "$value": 0.50, "$type": "number" },
      "text-dim": { "$value": 0.35, "$type": "number" }
    },
    "blur": {
      "panel": { "$value": "24px", "$type": "dimension" },
      "card": { "$value": "24px", "$type": "dimension" },
      "pill": { "$value": "24px", "$type": "dimension" }
    },
    "duration": {
      "instant": { "$value": "150ms", "$type": "duration" },
      "smooth": { "$value": "300ms", "$type": "duration" },
      "spring": { "$value": "500ms", "$type": "duration" }
    }
  },
  "semantic": {
    "surface": {
      "canvas": { "$value": "{primitive.color.canvas}", "$type": "color", "description": "Deep matte graphite canvas" },
      "sidebar": { "$value": "{primitive.color.sidebar}", "$type": "color", "description": "Clean fixed sidebar background" },
      "card": { "$value": "{primitive.color.surface}", "$type": "color", "description": "Cards and panels surface" },
      "hover": { "$value": "{primitive.color.surface-hover}", "$type": "color", "description": "Hover and active surface" },
      "active-pill": { "$value": "{primitive.color.surface-active}", "$type": "color", "description": "Active nav pill" },
      "border": { "$value": "{primitive.color.border}", "$type": "color", "description": "Subtle border" },
      "glass": { "$value": "{primitive.color.glass-frosted}", "$type": "color", "description": "Frosted acrylic glass" }
    },
    "text": {
      "primary": { "$value": "{primitive.color.white}", "$type": "color", "contrastRatio": "18.5:1" },
      "secondary": { "$value": "{primitive.color.text-secondary}", "$type": "color", "contrastRatio": "8.2:1" },
      "tertiary": { "$value": "{primitive.color.text-tertiary}", "$type": "color", "contrastRatio": "6.5:1" },
      "kicker": { "$value": "{primitive.color.text-tertiary}", "$type": "color" }
    }
  },
  "component": {
    "sidebar": {
      "width": { "$value": "240px", "$type": "dimension" },
      "background": { "$value": "{semantic.surface.sidebar}", "$type": "color" }
    },
    "playerPill": {
      "maxWidth": { "$value": "720px", "$type": "dimension" },
      "background": { "$value": "{semantic.surface.glass}", "$type": "color" },
      "blur": { "$value": "24px", "$type": "dimension" },
      "borderRadius": { "$value": "16px", "$type": "dimension" }
    },
    "playerbar": {
      "height": { "$value": "88px", "$type": "dimension" },
      "background": { "$value": "{semantic.surface.glass}", "$type": "color" },
      "blur": { "$value": "24px", "$type": "dimension" }
    },
    "scrubber": {
      "trackHeight": { "$value": "4px", "$type": "dimension" },
      "thumbSize": { "$value": "12px", "$type": "dimension" },
      "hoverTrackHeight": { "$value": "6px", "$type": "dimension" }
    }
  }
}
